{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "destination": "https://aftercore.ai/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://aftercore.ai/:path*",
      "statusCode": 301
    }
  ]
}
